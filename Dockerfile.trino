FROM python:3.14-slim
# Until the runtime and adapter packages publish to (Test)PyPI, install both
# from the build context; the contract from PyPI.
COPY pyproject.toml README.md /src/
COPY continuo_python_runtime /src/continuo_python_runtime
COPY python-runtime-trino /src/python-runtime-trino
RUN pip install --no-cache-dir \
      "continuo-validation-contract==0.6.0" \
      /src/python-runtime-trino \
      /src
# PYTHONPATH is belt-and-braces: the harness also inserts APP_ROOT and the
# node script's own directory at the front of sys.path before executing it,
# so a script's in-repo helper imports resolve. Neither WORKDIR nor the
# console-script entrypoint puts /app on sys.path by itself.
ENV CONTRACT_DIR=/app/contracts APP_ROOT=/app PYTHONPATH=/app
WORKDIR /app
ENTRYPOINT ["continuo-runtime", "run"]
